<?xml version="1.0"?>
<!-- 输入robot可以快速生成robot编写样本 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"> 
	<xacro:include filename="$(find robot_description)/urdf/robot/common_inertia.xacro"/>
	<xacro:macro name="base_xacro" params="length radius">
		<!-- 虚拟部件 用于调整机器人的整体离地高度 因为没有实体组件 所以没有额外参数 --> 
		<link name="base_footprint"/>
		<!-- ctrl+/可以快速生成urdf注释 -->
		<!-- 机器人的身体部分 -->
		<!-- 输入link可以快速生成机器人部件1link坐标系 -->
		<link name="base_link">
			<!-- 部件的外观描述 -->
			<!-- visual可视化部件 -->
			<visual>
				<!-- 1.沿着自己的几何中心的偏移量和旋转量 载体坐标系的相对量 默认单位米-->
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<!-- 2.几何形状 -->
				<geometry>
					<!-- 机器人的几何形状我们设置成半径0.1 高度0.12的圆柱体 -->
					<cylinder radius="${radius}" length="${length}"/>
				</geometry>
				<!-- 3.材质颜色 -->
				<material name="white">
					<!-- 四个值分别表示红绿蓝和透明度 -->
					<color rgba="1.0 1.0 1.0 0.5"/>
				</material>
			</visual>

			<collision>
				<!-- 1.沿着自己的几何中心的偏移量和旋转量 载体坐标系的相对量 默认单位米-->
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<!-- 2.几何形状 -->
				<geometry>
					<!-- 机器人的几何形状我们设置成半径0.1 高度0.12的圆柱体 -->
					<cylinder radius="${radius}" length="${length}"/>
				</geometry>
				<!-- 3.材质颜色 -->
				<material name="white">
					<!-- 四个值分别表示红绿蓝和透明度 -->
					<color rgba="1.0 1.0 1.0 0.5"/>
				</material>
			</collision>

			<xacro:cylinder_inertia m="20.0" r="${radius}" h="${length}"/>
		</link>

		<joint name="joint_name" type="fixed">
			<!-- 调整该虚拟组件距离机器人中心的高度为机器人高度的一半+轮子半径-0.001m -->
			<origin xyz="0.0 0.0 ${length/2.0+0.1-0.001}" rpy="0.0 0.0 0.0"/> 
			<parent link="base_footprint"/>
			<child link="base_link"/>
		</joint>
	</xacro:macro>
</robot>