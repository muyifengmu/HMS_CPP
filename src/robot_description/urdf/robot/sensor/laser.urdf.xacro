<?xml version="1.0"?>
<!-- 输入robot可以快速生成robot编写样本 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"> 
	<xacro:include filename="$(find robot_description)/urdf/robot/common_inertia.xacro"/>
	<xacro:macro name="laser_xacro" params="xyz">
		<!-- 机器人的IMU组件，惯性测量单元传感器 -->
		<!-- ctrl+/可以快速生成urdf注释 -->
		<!-- 机器人的身体部分 -->
		<!-- 输入link可以快速生成机器人部件link -->
		<!-- 雷达支撑杆 -->
		<link name="laser_cylinder_link">
			<!-- 部件的外观描述 -->
			<!-- visual可视化部件 -->
			<visual>
				<!-- 1.沿着自己的几何中心的偏移量和旋转量 载体坐标系的相对量-->
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<!-- 2.几何形状 -->
				<geometry>
					<!-- 雷达支撑杆的几何形状我们设置成半径为0.01 高为0.1的圆柱体 -->
					<cylinder radius="0.01" length="0.1"/>
				</geometry>
				<!-- 3.材质颜色 -->
				<material name="black">
					<!-- 四个值分别表示红绿蓝和透明度 -->
					<color rgba="0.0 0.0 0.0 1.0"/>
				</material>
			</visual>

			<xacro:cylinder_inertia m="0.05" r="0.01" h="0.1"/>
		</link>

		<!-- 雷达 -->
		<link name="laser_link">
			<!-- 部件的外观描述 -->
			<!-- visual可视化部件 -->
			<visual>
				<!-- 1.沿着自己的几何中心的偏移量和旋转量 载体坐标系的相对量-->
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<!-- 2.几何形状 -->
				<geometry>
					<!-- IMU的几何形状我们设置成棱为0.02的立方体 -->
					<cylinder radius="0.02" length="0.02"/>
				</geometry>
				<!-- 3.材质颜色 -->
				<material name="black">
					<!-- 四个值分别表示红绿蓝和透明度 -->
					<color rgba="0.0 0.0 0.0 1.0"/>
				</material>
			</visual>

			<collision>
				<!-- 1.沿着自己的几何中心的偏移量和旋转量 载体坐标系的相对量-->
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<!-- 2.几何形状 -->
				<geometry>
					<!-- IMU的几何形状我们设置成棱为0.02的立方体 -->
					<cylinder radius="0.02" length="0.02"/>
				</geometry>
				<!-- 3.材质颜色 -->
				<material name="black">
					<!-- 四个值分别表示红绿蓝和透明度 -->
					<color rgba="0.0 0.0 0.0 1.0"/>
				</material>
			</collision>

			<xacro:cylinder_inertia m="0.1" r="0.02" h="0.02"/>
		</link>

		<!-- 机器人的关节，用于组合机器人的部件 -->
		<joint name="laser_joint" type="fixed">
			<!-- 表示固定的位置 固定在几何中心向上5厘米的位置 因为雷达支撑杆的高度是10cm -->
			<origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
			<!-- 表示该关节固定雷达支撑杆laser_cylinder_link和雷达laser_link -->
			<parent link="laser_cylinder_link"/>
			<child link="laser_link"/>
		</joint>

		<joint name="laser_cylinder_joint" type="fixed">
			<!-- 表示固定的位置 固定在几何中心向上5厘米的位置 因为雷达支撑杆的高度是10cm -->
			<!-- 让用户能通过参数去改变雷达支撑杆的位置 -->
			<origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
			<!-- 表示该关节固定机器人本体base_link和惯性测量单元IMU_link -->
			<parent link="base_link"/>
			<child link="laser_cylinder_link"/>
		</joint>

		<!-- gazebo需要的材质颜色 -->
		<gazebo reference="laser_cylinder_link">
			<material>Gazebo/Black</material>
		</gazebo>

		<gazebo reference="laser_link">
			<material>Gazebo/Black</material>
		</gazebo>
	</xacro:macro>
</robot>