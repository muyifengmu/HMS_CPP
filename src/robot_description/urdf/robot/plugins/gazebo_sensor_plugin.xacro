<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="gazebo_sensor_plugin">
        <!-- 激光雷达插件配置 -->
        <gazebo reference="laser_link">
            <sensor name="laserscan" type="ray">
                <plugin name="laserscan" filename="libgazebo_ros_ray_sensor.so">
                    <ros>
                        <namespace>/</namespace>
                        <!-- 重映射话题的名字 -->
                        <remapping>~/out:=scan</remapping>
                    </ros>
                    <!-- 重映射话题的接口 -->
                    <output_type>sensor_msgs/LaserScan</output_type>
                    <!-- 重映射的坐标系 -->
                    <frame_name>laser_link</frame_name>
                </plugin>
                <always_on>true</always_on>
                <visualize>true</visualize>
                <update_rate>100</update_rate>
                <pose>0 0 0 0 0 0</pose>
                <!-- 激光传感器配置 -->
                <ray>
                    <!-- 设置扫描范围 -->
                    <scan>
                        <horizontal>
                            <!-- 设置采样数 分辨率比例 最小和最大角度 -->
                            <samples>360</samples>
                            <resolution>1.000000</resolution>
                            <min_angle>0.000000</min_angle>
                            <max_angle>6.280000</max_angle>
                        </horizontal>
                    </scan>
                    <!-- 设置扫描距离(m) -->
                    <range>
                        <min>0.120000</min>
                        <max>25.0</max>
                        <!-- 设置分辨率也就是雷达精度 -->
                        <resolution>0.015000</resolution>
                    </range>
                    <!-- 设置噪声(高斯噪声) -->
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </ray>
            </sensor>
        </gazebo>

        <!-- 惯性测量单元插件配置 -->
        <gazebo reference="imu_link">
            <sensor name="imu_sensor" type="imu">
                <!-- 使用libgazebo_ros_imu_sensor.so插件，这个插件支持IMU数据输出 -->
                <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
                    <ros>
                        <namespace>/</namespace>
                        <!-- 发布imu数据的话题设置 -->
                        <remapping>~/out:=imu</remapping>
                    </ros>
                    <initial_orientation_as_reference>false</initial_orientation_as_reference>
                </plugin>
                <update_rate>100</update_rate>
                <always_on>true</always_on>
                <!-- 六轴噪声设置 -->
                <imu>
                    <angular_velocity>
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>2e-4</stddev>
                                <bias_mean>0.0000075</bias_mean>
                                <bias_stddev>0.0000008</bias_stddev>
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>2e-4</stddev>
                                <bias_mean>0.0000075</bias_mean>
                                <bias_stddev>0.0000008</bias_stddev>
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>2e-4</stddev>
                                <bias_mean>0.0000075</bias_mean>
                                <bias_stddev>0.0000008</bias_stddev>
                            </noise>
                        </z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>1.7e-2</stddev>
                                <bias_mean>0.1</bias_mean>
                                <bias_stddev>0.001</bias_stddev>
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>1.7e-2</stddev>
                                <bias_mean>0.1</bias_mean>
                                <bias_stddev>0.001</bias_stddev>
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>1.7e-2</stddev>
                                <bias_mean>0.1</bias_mean>
                                <bias_stddev>0.001</bias_stddev>
                            </noise>
                        </z>
                    </linear_acceleration>
                </imu>
            </sensor>
        </gazebo>

        <!-- 绑定该gazebo深度相机和urdf中的camera_link组件坐标系 -->
        <gazebo reference="camera_link">
            <!-- 声明这是一个深度相机 -->
            <sensor type="depth" name="camera_sensor">
                <!-- 使用libgazebo_ros_camera.so插件，这个插件支持深度和RGB两种数据输出 -->
                <plugin name="depth_camera" filename="libgazebo_ros_camera.so">
                    <!-- 指定发布话题数据的坐标系为camera_optical_link -->
                    <frame_name>camera_optical_link</frame_name>
                </plugin>
                <!-- 传感器持续运行(即使无订阅) 更新频率设置为10hz/s -->
                <always_on>true</always_on>
                <update_rate>10</update_rate>
                <camera name="camera">
                    <!-- 水平视场角约86度（弧度1.5≈86°） -->
                    <horizontal_fov>1.5009831567</horizontal_fov>
                    <!-- 分辨率：800×600像素
                         格式：RGB 8位每通道（24位彩色） -->
                    <image>
                        <width>800</width>
                        <height>600</height>
                        <format>R8G8B8</format>
                    </image>
                    <!-- 畸变参数（已设为0，无畸变） -->
                    <distortion>
                        <k1>0.0</k1>
                        <k2>0.0</k2>
                        <k3>0.0</k3>
                        <p1>0.0</p1>
                        <p2>0.0</p2>
                        <center>0.5 0.5</center>
                    </distortion>
                </camera>
            </sensor>
        </gazebo>
    </xacro:macro>
</robot>