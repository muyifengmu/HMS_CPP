<?xml version="1.0"?>
<!-- 输入robot可以快速生成robot编写样本 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"> 
	<xacro:include filename="$(find robot_description)/urdf/robot/common_inertia.xacro"/>
	<xacro:macro name="wheel_xacro" params="wheel_name xyz">
		<!-- 机器人的IMU组件，惯性测量单元传感器 -->
		<!-- ctrl+/可以快速生成urdf注释 -->
		<!-- 机器人的身体部分 -->
		<!-- 输入link可以快速生成机器人部件link -->
		<link name="${wheel_name}_link">
			<!-- 部件的外观描述 -->
			<!-- visual可视化部件 -->
			<visual>
				<!-- 1.沿着自己的几何中心(即轮子的joint中心)的偏移量和旋转量 载体坐标系的相对量-->
				<origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>
				<!-- 2.几何形状 -->
				<geometry>
					<!-- 车轮的几何形状我们设置成半径为 0.1 的圆柱体 -->
					<cylinder radius="0.1" length="0.08"/>
				</geometry>
				<!-- 3.材质颜色 -->
				<material name="yellow">
					<!-- 四个值分别表示红绿蓝和透明度 -->
					<color rgba="1.0 1.0 0.0 0.8"/>
				</material>
			</visual>

			<collision>
				<!-- 1.沿着自己的几何中心(即轮子的joint中心)的偏移量和旋转量 载体坐标系的相对量-->
				<origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>
				<!-- 2.几何形状 -->
				<geometry>
					<!-- 车轮的几何形状我们设置成半径为 0.1 的圆柱体 -->
					<cylinder radius="0.1" length="0.08"/>
				</geometry>
				<!-- 3.材质颜色 -->
				<material name="yellow">
					<!-- 四个值分别表示红绿蓝和透明度 -->
					<color rgba="1.0 1.0 0.0 0.8"/>
				</material>
			</collision>

			<xacro:cylinder_inertia m="0.5" r="0.1" h="0.08"/>
		</link>

		<!-- 机器人的关节，用于组合机器人的部件 -->
		<joint name="${wheel_name}_joint" type="continuous">
			<!-- 表示固定的位置 通过参数进行指定-->
			<origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
			<!-- 表示该关节固定机器人本体base_link和惯性测量单元IMU_link -->
			<parent link="base_link"/>
			<child link="${wheel_name}_link"/>
			<axis xyz="0.0 1.0 0.0"/>
		</joint>

		<!-- gazebo需要的物理参数 -->
		<gazebo reference="${wheel_name}_link">
			<!-- mu1切向摩擦 mu2径向摩擦 kp刚度系数 kd阻尼系数-->
			<mu1 value="20.0"/> 
			<mu2 value="20.0"/>
			<kp value="1000000000.0"/>
			<kd value="1.0"/>
		</gazebo>
	</xacro:macro>
</robot>
